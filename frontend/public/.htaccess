# Single-page app on Apache/cPanel: send every path that is not a real file to index.html,
# so /book-visit, /sign/<token>, /supplier/<token>, /data-request ... work when opened directly.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
# Never cache the shell page, cache hashed assets for a year
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-store"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?|png|jpg|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
</IfModule>
