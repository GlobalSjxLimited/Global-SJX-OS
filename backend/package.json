{
  "name": "gsjx-os-backend",
  "version": "1.0.0",
  "description": "Global SJX OS \u2014 internal operating system backend (TypeScript, Express, MongoDB)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "ts-node-dev --transpile-only src/seed/seed.ts",
    "typecheck": "tsc --noEmit",
    "migrate:legacy": "ts-node --transpile-only scripts/migrate-legacy.ts",
    "migrate:selftest": "ts-node --transpile-only scripts/migrate-legacy.selftest.ts",
    "test": "jest --runInBand",
    "bootstrap": "ts-node --transpile-only scripts/bootstrap-production.ts",
    "import:folder": "ts-node --transpile-only scripts/import-isms-folder.ts",
    "mail:test": "ts-node --transpile-only scripts/test-email.ts"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.13.0",
    "mongoose": "^8.4.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.16",
    "otplib": "^12.0.1",
    "pdfkit": "^0.15.0",
    "pino": "^9.2.0",
    "pino-http": "^10.1.0",
    "qrcode": "^1.5.3",
    "sanitize-html": "2.18.0",
    "uuid": "^11.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^6.4.15",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.5",
    "@types/sanitize-html": "^2.13.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.2.0",
    "pino-pretty": "^11.2.1",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.19"
  }
}
